APP_NAME="سامانه قیمت طلا"

# Runtime environment. Recommended for live hosting: production.
APP_ENV=production

# Required Laravel encryption key. Generate with: php artisan key:generate
# Recommended: set once on production and do not change it later.
APP_KEY=

# Shows detailed errors when true. Recommended for production: false.
APP_DEBUG=false

# Public website URL. Recommended: use the final HTTPS domain.
APP_URL=https://gold.ernoxin.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gold_prices
DB_USERNAME=gold_user
DB_PASSWORD=

# Queue driver. Recommended: sync for this small app because no worker process is required.
QUEUE_CONNECTION=sync

# Session storage. Recommended: file for simple cPanel hosting.
SESSION_DRIVER=file

# Price source page. Recommended: keep the official estjt price URL.
ESTJT_SOURCE_URL=https://www.estjt.ir/price/

# Internal source label stored in the database. Recommended: estjt.
ESTJT_SOURCE_NAME="اتحادیه صنف فروشندگان و سازندگان طلا و جواهر و نقره و سکه تهران"

# Auto-fetch interval in minutes. Recommended: 5 to avoid too many external requests.
ESTJT_FETCH_INTERVAL_MINUTES=1

# HTTP connection timeout in seconds. Recommended: 3.
ESTJT_TIMEOUT_CONNECT=2

# HTTP response/read timeout in seconds. Recommended: 8.
ESTJT_TIMEOUT_READ=3

# Number of retries after a failed source request. Recommended: 2.
ESTJT_RETRY_COUNT=5

# Delay between retries in milliseconds. Recommended: 300.
ESTJT_RETRY_BACKOFF_MS=300

# Browser-like user agent for estjt requests. Recommended: keep a normal desktop browser value.
ESTJT_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# Preferred languages sent to estjt. Recommended: Persian first.
ESTJT_ACCEPT_LANGUAGE=fa-IR,fa;q=0.9,en-US;q=0.8,en;q=0.7

# Referer header sent to estjt. Recommended: keep the estjt homepage.
ESTJT_REFERER=https://www.estjt.ir/

# Enables automatic PHP-based fetching when the summary API is requested. Recommended: true.
FEATURE_AUTO_FETCH=true

# Enables dark mode support in the frontend. Recommended: true.
FEATURE_DARK_MODE=true

# Enables POST /api/market/fetch for manual refresh. Recommended for production: false.
FEATURE_MANUAL_FETCH_API=false

# Connects to DB and runs pending migrations from normal web requests.
# Recommended on cPanel without SSH: true.
# Behavior: empty DB creates all tables; future migration files add/update tables automatically.
HOSTING_AUTO_MIGRATE=true

# Creates/fixes writable runtime folders during web requests. Recommended on cPanel: true.
HOSTING_ENSURE_WRITABLE_PATHS=true

# Default chart range in days. Recommended: 7.
CHART_DEFAULT_RANGE_DAYS=7

# Available chart ranges in days. Recommended: keep common short and long ranges.
CHART_AVAILABLE_RANGES=1,7,30,90,180,365

# Maximum chart points returned per request. Recommended: 600 for smooth mobile charts.
CHART_MAX_POINTS=600

# Maximum historical range allowed by API. Recommended: 365.
HISTORY_MAX_DAYS=365

# Default frontend theme. Recommended: dark.
THEME_DEFAULT=dark

# Main accent color. Recommended: gold color matching the app brand.
THEME_ACCENT=#d9a441
