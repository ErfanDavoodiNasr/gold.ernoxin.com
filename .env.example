APP_NAME="سامانه قیمت طلا"

# Runtime environment. Recommended for live hosting: production.
APP_ENV=production

# Laravel encryption key. On first run the app copies this file to .env and fills APP_KEY if empty.
APP_KEY=

# Shows detailed errors when true. Recommended for production: false.
APP_DEBUG=false

# Public website URL. Recommended: use the final HTTPS domain.
APP_URL=https://gold.ernoxin.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gold_prices
DB_USERNAME=gold_user
DB_PASSWORD=

# Price source page. Recommended: keep the official estjt price URL.
ESTJT_SOURCE_URL=https://www.estjt.ir/price/

# Short internal source key stored in the database. Recommended: estjt.
ESTJT_SOURCE_KEY=estjt

# Display source name shown in the API/frontend.
ESTJT_SOURCE_NAME="اتحادیه صنف فروشندگان و سازندگان طلا و جواهر و نقره و سکه تهران"

# Auto-fetch interval in minutes.
ESTJT_FETCH_INTERVAL_MINUTES=1

# Cache market summary responses briefly for faster page loads.
MARKET_SUMMARY_CACHE_SECONDS=10

# Browser auto-refresh interval in seconds while the tab is visible. Recommended: 60.
FRONTEND_REFRESH_SECONDS=60

# HTTP connection timeout in seconds. Recommended: 3.
ESTJT_TIMEOUT_CONNECT=3

# HTTP response/read timeout in seconds. Recommended: 5.
ESTJT_TIMEOUT_READ=5

# Number of retries after a failed source request. Recommended: 1 for minute-based cron.
ESTJT_RETRY_COUNT=1

# Delay between retries in milliseconds. Recommended: 150.
ESTJT_RETRY_BACKOFF_MS=150

# Browser-like user agent for estjt requests. Recommended: keep a normal desktop browser value.
ESTJT_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# Preferred languages sent to estjt. Recommended: Persian first.
ESTJT_ACCEPT_LANGUAGE=fa-IR,fa;q=0.9,en-US;q=0.8,en;q=0.7

# Referer header sent to estjt. Recommended: keep the estjt homepage.
ESTJT_REFERER=https://www.estjt.ir/

# Default chart range. Supports h for hours and d for days. Recommended: 1d.
CHART_DEFAULT_RANGE=1d

# Available chart ranges. Supports h for hours and d for days.
CHART_AVAILABLE_RANGES=1h,2h,6h,12h,1d,7d,30d,90d,180d,365d

# Maximum chart points returned per request. Recommended: 600 for smooth mobile charts.
CHART_MAX_POINTS=600

# Maximum historical range allowed by API. Recommended: 365.
HISTORY_MAX_DAYS=365

# Default frontend theme. Recommended: system.
THEME_DEFAULT=system

# Main accent color. Recommended: gold color matching the app brand.
THEME_ACCENT=#d9a441
