APP_NAME="سامانه قیمت طلا"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gold.ernoxin.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gold_prices
DB_USERNAME=gold_user
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

ESTJT_SOURCE_URL=https://www.estjt.ir/price/
ESTJT_SOURCE_NAME=estjt
ESTJT_FETCH_INTERVAL_MINUTES=5
ESTJT_TIMEOUT_CONNECT=3
ESTJT_TIMEOUT_READ=8
ESTJT_RETRY_COUNT=2
ESTJT_RETRY_BACKOFF_MS=300
ESTJT_CACHE_SECONDS=60
ESTJT_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
ESTJT_ACCEPT_LANGUAGE=fa-IR,fa;q=0.9,en-US;q=0.8,en;q=0.7
ESTJT_REFERER=https://www.estjt.ir/

FEATURE_AUTO_FETCH=true
FEATURE_DARK_MODE=true
FEATURE_MANUAL_FETCH_API=false
CHART_DEFAULT_RANGE_DAYS=7
CHART_AVAILABLE_RANGES=1,7,30,90,180,365
CHART_MAX_POINTS=600
HISTORY_MAX_DAYS=365
THEME_DEFAULT=dark
THEME_ACCENT=#d9a441
